# Production / Vercel: backend origin only — include https:// (or http:// for local).
# No path suffix; no quotes in the dashboard value.
# Leave unset for local dev (Vite proxies /api to localhost:8787).
# VITE_API_ORIGIN=https://your-backend.vercel.app
# Host-only also works after normalization: your-backend.vercel.app
